<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>SimpleRobot.PluginSdk</RootNamespace>
    <AssemblyName>SimpleRobot.PluginSdk</AssemblyName>
    <Version>1.0.0</Version>
    <Description>SDK for writing SimpleRobotController plugins in C#.</Description>
    <PackageId>SimpleRobot.PluginSdk</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
