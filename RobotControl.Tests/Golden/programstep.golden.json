  "variableExpr": "$counter + 1",
  "expressions": { "speed": "$v * 2" },
  "gridPoint": { "gridId": "grid-1", "rowIndex": 1, "colIndex": 2, "gridIndex": 5, "useGridIndex": false },
  "stackPoint": { "stackId": "stack-1", "index": 2 },
  "labelId": "label-guid-1",
  "labelName": "loop_start",
  "condition": { "combinator": "ALL", "items": [{ "id": "ci-1", "left": "$x", "operator": "==", "right": "1" }] },
  "ifSteps": [{ "id": "nested-if-1", "type": "Wait", "waitMs": 100 }],
  "elseIfBranches": [{ "id": "elif-1", "condition": { "combinator": "ANY", "items": [] }, "steps": [{ "id": "nested-elif-1", "type": "Wait", "waitMs": 100 }] }],
  "elseSteps": [{ "id": "nested-else-1", "type": "Wait", "waitMs": 100 }],
  "toolName": "Gripper",
  "toolId": "tool-1",
  "jointIndex": 2,
  "jointValue": 90,
  "localName": "Fixture1",
  "localId": "local-1",
  "jumpZ": 50,
  "jumpZStart": 40,
  "jumpZEnd": 60,
  "visionProgramId": "vp-1",
  "visionProgramName": "Detect Parts",
  "passVariable": "visionOk",
  "toolOutputs": [{ "toolId": "t1", "value": "angle", "variable": "edgeAngle" }, { "toolId": "t5", "value": "cells", "variable": "whiteCells" }],
  "varPointName": "pts",
  "varPointIndex": "$i",
  "pointNameExpr": "{$binPrefix}{$index}",
  "backgroundProgramName": "BgProg",
  "backgroundProgramId": "bg-guid-1",
  "stopwatchAction": "Start",
  "stopwatchVariableName": "timer",
  "saveImagePath": "captures/img_$time_ms.jpg",
  "saveImageCameraId": "cam-1",
  "recordVariableName": "forceData",
  "exportFormat": "csv",
  "exportPath": "exports/run_$time_ms.csv",
  "exportColumns": [{ "key": "t", "expr": "$t" }, { "key": "data", "listVar": "forceData" }],
  "waitMode": "condition",
  "waitCondition": { "combinator": "ALL", "items": [{ "id": "wc-1", "left": "$stb.in1", "operator": "==", "right": "1" }] },
  "waitTimeoutMs": 5000,
  "waitTimeoutVariableName": "timedOut",
  "loopMode": "while",
  "forEachVariableName": "list",
  "forEachValueVariableName": "item",
  "forEachIndexVariableName": "i",
  "loopWhileCondition": { "combinator": "ANY", "items": [{ "id": "lw-1", "left": "$i", "operator": "<", "right": "10" }] },
  "auxDeviceId": "aux-1",
  "auxAxisIndex": 0,
  "auxSteps": -1600,
  "auxDistance": 25.5,
  "auxUnit": "mm",
  "auxVelocity": 800,
  "auxAccel": 2000,
  "auxDecel": 2000,
  "auxWaitForDone": true,
  "auxImmediate": false,
  "auxAbsolute": false,
  "auxEnable": true,
  "gripperAction": "Open",
  "gripTargetMm": 30,
  "conveyorAction": "RunForward",
  "rotaryDirection": 1,
  "rotaryCount": 1,
  "threadDistance": -12,
  "threadPitch": 1.25,
  "threadPeck": true,
  "threadPeckDepth": 3,
  "threadPeckRetract": 2,
  "threadExitHeight": 5,
  "threadReverseOut": true,
  "pluginId": "scale",
  "pluginStepId": "weigh",
  "pluginParams": { "samples": "$n * 2", "unit": "g", "label": "Bin {$i}", "stable": "true", "target": "P1", "weights": "history" },
  "pluginOutputs": [ { "key": "grams", "variableName": "weight" }, { "key": "where", "variableName": "pickPts" } ],
  "pluginTimeoutMs": 5000,
  "jsonUrl": "http://192.168.4.10:8080/move",
  "jsonWaitForResponse": true,
  "jsonTimeoutMs": 5000,
  "jsonOutbound": [{ "key": "n", "expr": "$count" }, { "key": "photo", "expr": "", "imageVar": "photo" }, { "key": "board", "expr": "", "listVar": "cells" }],
  "jsonInbound": [{ "key": "move", "variableName": "move" }],
  "jsonImageOutbound": [{ "key": "img", "variableName": "photo" }],
  "captureImageVariableName": "photo",
  "captureImageCameraId": "cam-1",
  "httpReceiveName": "checkers",
  "httpReceiveTimeoutMs": 60000,
  "httpReceiveInbound": [{ "key": "x", "variableName": "x" }],
  "unknownStepType": "MoveWithForce",
  "noteStyle": "section",
  "loopControl": "continue",
  "errorMessage": "No part at {$i}",
  "errorCode": "noPart",
  "switchExpr": "$bin",
  "switchCases": [{ "id": "case-1", "values": ["1", "2"], "steps": [{ "id": "nested-case-1", "type": "Wait", "waitMs": 100 }] }],
  "switchDefault": [{ "id": "nested-default-1", "type": "Wait", "waitMs": 100 }],
  "trySteps": [{ "id": "nested-try-1", "type": "Wait", "waitMs": 100 }],
  "catchSteps": [{ "id": "nested-catch-1", "type": "Note", "comment": "ignored", "noteStyle": "note" }],
  "tryRetries": 2,
  "tryRetryDelayMs": 500,
  "catchCodes": ["waitTimeout", "httpFailed"],
  "errorVariableName": "errMsg",
  "errorCodeVariableName": "errCode",
  "waitTimeoutAction": "error",
  "routineArgs": { "height": "20", "count": "$n" },
  "routineOutputs": [{ "key": "found", "variableName": "ok" }],
  "outputAction": "toggle",
  "savePositionTo": "variable",
  "savePositionMode": "append",
  "savePositionIndex": 0,
  "savePositionSource": "actual",
  "speedFactor": 50,
  "viaPointId": "point-guid-2",
  "viaPointName": "P2",
  "viaPointNameExpr": "$pts[1]",
  "arcTolerance": 0.1,
  "listAction": "insert",
  "listIndex": 0,
  "listValueExpr": "$grams",
  "listFields": { "x": "$robot.x", "z": "5" },
  "listSourceVariable": "vals",
  "listSortField": "value",
  "listSortDescending": true,
  "promptTitle": "Setup",
  "promptMessage": "Load the tray",
  "promptButtons": ["Continue", "Skip"],
  "promptInput": "number",
  "promptDefault": "10",
  "promptMin": 1,
  "promptMax": 50,
  "promptResultVariableName": "choice",
  "promptInputVariableName": "qty",
  "promptTimeoutMs": 60000,
  "promptTimeoutButton": 0,
  "cncDxfFile": "part.dxf",
  "cncSafeZ": 10,
  "cncProgramSteps": [{ "id": "nested-cnc-1", "type": "Wait", "waitMs": 100 }],
  "cncSpec": {
    "file": "part.svg",
    "safeZ": 10,
    "holes": [{ "x": 5, "y": 6 }],
    "holeIndexes": [0],
    "holeOp": "thread",
    "holeDepth": -12,
    "threadPitch": 1.25,
    "holePeck": true,
    "holePeckDepth": 3,
    "threadReverseOut": true,
    "paths": [[0, 0, 10, 0, 10, 10]],
    "contourIndexes": [0, 2],
    "scale": 1.5,
    "offsetX": 100,
    "offsetY": 50,
    "flipY": true,
    "activeZ": -1,
    "activeSpeed": 40,
    "activeAccel": 800,
    "activeDecel": 800,
    "travelSpeed": 150,
    "travelAccel": 1500,
    "travelDecel": 1500,
    "blendRadius": 1,
    "detail": 0.05,
    "joinTolerance": 0.1,
    "offsetMode": "outside",
    "offsetDistance": 1.5,
    "originMode": "current",
    "contourReversed": [1],
    "contourStarts": { "0": { "x": 5, "y": 5 } },
    "expressions": { "activeSpeed": "$feed * 2" }
  }
}
