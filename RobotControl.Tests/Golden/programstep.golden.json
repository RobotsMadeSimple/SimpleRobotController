{
  "id": "step-golden-1",
  "type": "MoveL",
  "name": "Golden step",
  "comment": "Golden comment",
  "enabled": true,
  "outputFrame": "robot",
  "pointName": "P1",
  "pointId": "point-guid-1",
  "speed": 200,
  "accel": 500,
  "decel": 500,
  "blend": true,
  "blendRadius": 15,
  "offsetX": 1, "offsetY": 2, "offsetZ": 3,
  "offsetRX": 0.1, "offsetRY": 0.2, "offsetRZ": 0.3,
  "toolOffsetX": 1, "toolOffsetY": 2, "toolOffsetZ": 3,
  "toolOffsetRX": 0.1, "toolOffsetRY": 0.2, "toolOffsetRZ": 0.3,
  "overrideX": 10, "overrideY": 20, "overrideZ": 30,
  "overrideRX": 1, "overrideRY": 2, "overrideRZ": 3,
  "outputNumber": 1,
  "outputValue": true,
  "outputCard": "stb",
  "outputDeviceId": "nano-1",
  "pulseMs": 250,
  "pulseBlocking": true,
  "loadCellDeviceId": "nano-1",
  "loadCellPin": 4,
  "loadCellUnit": "g",
  "moveStopCondition": { "combinator": "ALL", "items": [{ "id": "ms-1", "expr": "$io.Arduino_Nano.Load_Cell >= 2000" }] },
  "moveStopMode": "stop",
  "moveStopPositionVariableName": "contactPts",
  "moveStopFlagVariableName": "contactHit",
  "waitMs": 500,
