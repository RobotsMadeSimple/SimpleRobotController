root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = block_scoped:silent
dotnet_diagnostic.CS1058.severity = warning
